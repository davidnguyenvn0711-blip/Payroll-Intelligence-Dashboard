# PostgreSQL/Supabase dùng để lưu dữ liệu bền vững trên bản web.
DATABASE_URL = "postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Khóa riêng dùng cho session. Tạo chuỗi ngẫu nhiên dài ít nhất 32 ký tự.
SESSION_SECRET = "THAY_BANG_CHUOI_NGAU_NHIEN"

